# Port this server listens on.
PORT=3000

# MongoDB connection string.
MONGO_URI=mongodb://127.0.0.1:27017/deployment_maintainer

# Identity and secret for this server. Copy both from the dashboard's "Add Server" dialog.
# SERVER_ID: 8-64 characters (letters, digits, _ or -).
SERVER_ID=
# SERVER_SECRET: at least 32 characters; the dashboard sends it as a Bearer token.
SERVER_SECRET=

# 32-byte (64 hex character) key used to encrypt app env values at rest (AES-256-GCM).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Fine-grained GitHub PAT (Contents + Metadata read-only, all repos). Needed to list repos and clone; see DEPLOYMENT.md §2.2.
GITHUB_TOKEN=

# Absolute path where deployed app folders live.
APPS_DIR=/home/ubuntu/apps

# Absolute path where static sites are published for Nginx to serve (kind=static apps).
# On Ubuntu /home/ubuntu is mode 750, so Nginx cannot read under it: use e.g. /var/www/deployer
# (sudo mkdir -p /var/www/deployer && sudo chown ubuntu:ubuntu /var/www/deployer). Defaults to <APPS_DIR>/../published.
PUBLISHED_DIR=

# Absolute path where per-app Nginx location files are written.
NGINX_APPS_DIR=/etc/nginx/deployer-apps

# First port allocated to a new app; each subsequent app gets the next free port.
APP_PORT_START=4001

# Node version used when an app doesn't specify one.
DEFAULT_NODE_VERSION=20

# Whether the nginx step actually writes/reloads Nginx config. Set to false on Mac dev.
NGINX_ENABLED=true

# Probe every app's health endpoint once a minute (needs the app's "Health check" step enabled and a GET
# endpoint returning 200). Off by default.
HEALTH_MONITOR=false

# development | production
NODE_ENV=development

# Base URL repos are cloned from: "<GIT_REMOTE_BASE>/<owner>/<repo>.git". Override
# in tests to point at a local fixture.
GIT_REMOTE_BASE=https://github.com
