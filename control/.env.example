# Port the control plane listens on.
PORT=3100

# MongoDB connection string (its own database, separate from any server's).
MONGO_URI=mongodb://127.0.0.1:27017/deployment_control

# Secret used to sign session JWTs. Must be at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# 32-byte (64 hex character) key used to encrypt stored server secrets at rest (AES-256-GCM).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Seeded single admin account. Re-running `npm run seed` resets the password to this value.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# development | production (production marks the session cookie Secure, so login needs HTTPS)
NODE_ENV=development

# Allow plain http:// server URLs for non-localhost hosts (dev only).
ALLOW_INSECURE_SERVER_URLS=false

# Comma-separated exact origins allowed to call this API from a browser (CORS + CSRF origin check),
# e.g. https://deploy.example.com,http://localhost:5173 (no paths, no trailing slash).
# Needed when the web UI is hosted elsewhere (e.g. Vercel); leave empty when this control plane
# serves the UI itself (same origin).
CORS_ORIGINS=
